{
  "_說明": "複製成 config.json 再改（config.json 不進版控）。金鑰不寫在這裡：DeepSeek 用環境變數 DEEPSEEK_API_KEY。providers 的格式與 Novel Studio 相同，之後整合時可以直接共用。",
  "providers": [
    {
      "id": "deepseek",
      "type": "openai",
      "name": "DeepSeek",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-flash",
      "key_env": "DEEPSEEK_API_KEY",
      "context_tokens": 128000,
      "max_output": 32000,
      "temperature": 1.0,
      "json_mode": true
    },
    {
      "id": "llamacpp",
      "type": "openai",
      "name": "llama.cpp（本機）",
      "base_url": "http://127.0.0.1:8080/v1",
      "model": "",
      "key_env": "",
      "context_tokens": 32768,
      "max_output": 10000,
      "temperature": 0.8,
      "json_mode": true
    }
  ],
  "default_provider": "deepseek",
  "stage_providers": {
    "_說明": "每個階段可以指定不同的模型；空字串＝用 default_provider。",
    "adapt": "",
    "script": "",
    "storyboard": ""
  },
  "comfy": {
    "url": "http://127.0.0.1:8188",
    "workflow": "workflows/moss_layout.api.json",
    "models": {
      "unet": "moss_image_sft_int8_convrot.safetensors",
      "clip": "qwen3.5_9b_w4a8_gptq.safetensors",
      "vae": "flux2-vae_small.safetensors"
    },
    "default_preset": "final",
    "presets": {
      "_說明": "出圖預設：steps、cfg、sampler、scheduler、lora（ComfyUI 列出的名稱，含子資料夾）、lora_strength。tools/panels.py 用 --preset 選；不是 default_preset 的，檔名會加後綴。S1 實測：draft 約快 3.3 倍，final 的網點與墨線比較有漫畫感。",
      "final": {
        "steps": 25,
        "cfg": 2.5,
        "sampler": "er_sde",
        "scheduler": "simple"
      },
      "draft": {
        "steps": 4,
        "cfg": 1.0,
        "sampler": "euler",
        "scheduler": "simple",
        "lora": "ANIMA\\moss_image_sft_4step_v2.0.safetensors",
        "lora_strength": 1.0
      }
    }
  },
  "lettering": {
    "_說明": "嵌字用的字型（TTF／OTF／TTC 的完整路徑）。字型不隨專案發佈，請自己安裝並確認授權。",
    "dialogue_font": "",
    "narration_font": "",
    "sfx_font": "",
    "vertical": true
  }
}
